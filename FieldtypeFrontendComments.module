        $text = '<p>' . $this->_('First, you will need to add this field to a template where you want to display comments.');
        $text .= '<br>' . $this->_('After that, put this code on a position inside this template, where the form and the comment list should be displayed.') . '</p>';
        $text .= '<h3>' . $this->_('The easiest way to integrate comments') . '</h3>';
        $text .= '<p>' . $this->_('In this case, the global settings are applied.') . '</p>';
        $text .= '<pre><code>echo $page->' . $field->name . '->render();</code></pre>';
        $text .= '<p>' . $this->_('Copy this line of code and add it to your template, where the comments should be displayed.') . '</p>';
        $text .= '<h3>' . $this->_('Integration of comments with user-defined settings per field') . '</h3>';
        $text .= '<p>' . $this->_('If needed, almost every parameter of the global settings can be overwritten within the templates.') . '</p>';
        $text .= '<pre><code>';
        $text .= '$comments = $page->' . $field->name . ';<br>';
        $text .= '$comments->setModeration(2);<br>';
        $text .= '$comments->setLoginRequired(true);<br>';
        $text .= '$comments->showWebsiteField(false);<br>';
        $text .= '$comments->setEmailTemplate("template_4.html");<br>';
        $text .= '$comments->setModerationEmail("email1@mydomain.com,email2@mydomain.com");<br>';
        $text .= '$comments->setReplyNotification(2);<br>';
        $text .= '$comments->setStatusChangeNotification(["1","2"]);<br>';
        $text .= '$comments->setFormHeadlineTag("h1");<br>';
        $text .= '$comments->showStarRating(2);<br>';
        $text .= '$comments->disableTooltip(false);<br>';
        $text .= '$comments->hideCharacterCounter(true);<br>';
        $text .= '$comments->setPrivacyType(1);<br>';
        $text .= '$comments->setListHeadlineTag("h1");<br>';
        $text .= '$comments->setReplyDepth(1);<br>';
        $text .= '$comments->sortNewestToOldest(true);<br>';
        $text .= '$comments->showVoting(false);<br>';
        $text .= '$comments->setDateFormat(0);<br>';
        $text .= '$comments->setCaptchaType("none");<br>';
        $text .= '$comments->setPaginationNumber(10);<br>';
        $text .= '$comments->setPaginationAlignment("right");<br>';
        $text .= '$comments->setSenderEmailAddress("myemailaddress@example.com");<br>';
        $text .= '$comments->setSenderName("ProcessWire");<br>';
        $text .= '$comments->setListHeadlineText("My comment list headline");<br>';
        $text .= '$comments->setFormHeadlineText("My form headline");<br>';
        $text .= '$comments->showFormAfterComments(false);<br>';
        $text .= '$comments->removeJS(true);<br>';
        $text .= '$comments->removeCSS(false);<br>';
        $text .= '$comments->setFormHeadlineText("none");<br>';
        $text .= 'echo $comments->render();';
        $text .= '</code></pre>';
        $link = '<a href ="https://github.com/juergenweb/FrontendComments\" target="_blank">' . $this->_('docs') . '</a>';
        $text .= '<p>' . sprintf($this->_('You can find much more information about this module inside the %s.'), $link) . '</p>';

        /**  InputfieldMarkup $description */
        $description = $this->wire()->modules->get('InputfieldMarkup');
        $description->set('markupText', $text);
        $docFieldset->add($description);
        $inputfields->add($docFieldset);

        // output all input fields (parent and custom)
        return $inputfields;
    }

    /**
     * Run during installation
     * @return void
     */
    public function ___install(): void
    {

        // create a table for queuing emails that will be sent to users
        if (!$this->database->tableExists(self::queueTable)) {
            $sql = '
            CREATE TABLE ' . self::queueTable . ' (
                id int unsigned NOT NULL auto_increment,
                parent_id int unsigned NOT NULL,
                comment_id int unsigned NOT NULL,
                email varchar(255) NOT NULL,
                page_id int unsigned NOT NULL,
                field_id int unsigned NOT NULL,
                claimed int unsigned NOT NULL default 0,
                PRIMARY KEY (id),
                INDEX created (comment_id),
                INDEX claimed (claimed)
            )
            ';

            $this->database->exec($sql);
        }
    }

    /**
     * Method, which runs on uninstalling of this module
     * @return void
     */
    public function ___uninstall(): void
    {
        // uninstall the FrontendCommentsManager module too if it is installed
        if (wire('modules')->isInstalled('FrontendCommentsManager')) {
            wire('modules')->uninstall('FrontendCommentsManager');
        }

        // delete the queue table
        $this->database->query("DROP TABLE IF EXISTS " . self::queueTable);
    }

    /**
     * Runs automatically when ProcessWire detects that the installed module version is older
     * than this file's version (see getModuleInfo()['version'])
     * @param string|int $fromVersion
     * @param string|int $toVersion
     * @return void
     */
    public function ___upgrade($fromVersion, $toVersion): void
    {
        // 1.0.7: add the "claimed" column to the queue table for sites that installed this
        // module before that column existed (see queueTableHasClaimedColumn() / sendQueuedEmails())
        if ($this->database->tableExists(self::queueTable) && !$this->queueTableHasClaimedColumn()) {
            $this->database->exec("ALTER TABLE " . self::queueTable . " ADD COLUMN claimed int unsigned NOT NULL default 0 AFTER field_id, ADD INDEX claimed (claimed)");
        }

        // 1.0.8: add the "notification_confirmed" column (double opt-in for notification emails,
        // see getDatabaseSchema()) to every EXISTING comment field's own table. A brand new comment
        // field created after this version gets the column automatically, straight from
        // getDatabaseSchema() - but a comment field's table that already existed before this
        // version does NOT get retroactively altered just because this file's version number went
        // up: ProcessWire only compares/syncs a Fieldtype-managed table's schema against
        // getDatabaseSchema() when that specific FIELD is saved (Setup > Fields > field > Save),
        // not on every request or module upgrade. Without this loop, any query referencing the new
        // column (e.g. FrontendComment::addCommentToQueueTable()) fails with "Unknown column" on
        // every site that updated the module code without also re-saving each comment field.
        foreach ($this->wire('fields') as $field) {
            if (!($field->type instanceof self)) {
                continue;
            }
            $table = $field->table;
            if ($table && $this->database->tableExists($table) && !$this->fieldTableHasNotificationConfirmedColumn($table)) {
                $this->database->exec("ALTER TABLE " . $this->database->escapeTable($table) . " ADD COLUMN notification_confirmed tinyint(3) NOT NULL default 0");
            }
        }

        // 1.0.9: add the "reminder_sent" column (see getDatabaseSchema() / sendPendingReminders())
        // to every EXISTING comment field's own table, for the exact same reason and via the exact
        // same mechanism as the "notification_confirmed" migration right above.
        foreach ($this->wire('fields') as $field) {
            if (!($field->type instanceof self)) {
                continue;
            }
            $table = $field->table;
            if ($table && $this->database->tableExists($table) && !$this->fieldTableHasReminderSentColumn($table)) {
                $this->database->exec("ALTER TABLE " . $this->database->escapeTable($table) . " ADD COLUMN reminder_sent tinyint(3) NOT NULL default 0");
            }
        }
    }

    /**
     * Check whether the queue table already has the "claimed" column
     * (used by ___upgrade() to migrate sites that installed this module before that column existed)
     * @return bool
     */
    protected function queueTableHasClaimedColumn(): bool
    {
        $result = $this->database->query("SHOW COLUMNS FROM " . self::queueTable . " LIKE 'claimed'");
        return (bool)$result->rowCount();
    }

    /**
     * Check whether a given comment field's own table already has the "notification_confirmed"
     * column (used by ___upgrade() to migrate sites that installed/updated this module before that
     * column existed - see the 1.0.8 block above)
     * @param string $table
     * @return bool
     */
    protected function fieldTableHasNotificationConfirmedColumn(string $table): bool
    {
        $result = $this->database->query("SHOW COLUMNS FROM " . $this->database->escapeTable($table) . " LIKE 'notification_confirmed'");
        return (bool)$result->rowCount();
    }

    /**
     * Check whether a given comment field's own table already has the "reminder_sent" column
     * (used by ___upgrade() to migrate sites that installed/updated this module before that column
     * existed - see the 1.0.9 block above)
     * @param string $table
     * @return bool
     */
    protected function fieldTableHasReminderSentColumn(string $table): bool
    {
        $result = $this->database->query("SHOW COLUMNS FROM " . $this->database->escapeTable($table) . " LIKE 'reminder_sent'");
        return (bool)$result->rowCount();
    }

    /**
     * Get default values for configuration fields
     * This is necessary to get them via getModuleConfig() without saving the configuration page after the
     * installation If the values are not stored inside the DB, they are not reachable via getModuleConfig();
     * return an array
     */
    public static function getDefaultData(): array
    {

        return [
            'input_fc_moderate' => 0,
            'input_fc_quiet_save' => 0,
            'input_fc_loggedin_only' => 0,
            'input_fc_userimage' => 'none',
            'input_fc_showWebsite' => 0,
            'input_fc_website' => 'none',
            'input_fc_author' => 'name',
            'input_fc_emailTemplate' => 'inherit',
            'input_fc_emailtype' => 'text',
            'input_fc_default_to' => '',
            'input_fc_emailfield' => '',
            'input_fc_from_name' => '',
            'input_fc_comment_notification' => 1,
            'input_fc_status_change_notification' => [],
            'input_fc_pendingReminderDays' => 1,
            'input_fc_form_headline' => '',
            'input_fc_form_tag_headline' => 'h2',
            'input_fc_privacy_show' => 2,
            'input_fc_stars' => 0,
            'input_fc_counter' => 0,
            'input_guidelines_type' => 0,
            'input_fc_comments_headline' => '',
            'input_fc_comments_tag_headline' => 'h2',
            'input_fc_sort' => 0,
            'input_fc_vote' => 0,
            'input_fc_voting_lock' => 3,
            'input_removeFrontendCommentsJS' => 0,
            'input_removeFrontendCommentsCSS' => 0,
            'input_fc_reverse_output' => 0,
            'input_fc_spam' => 3,
            'input_fc_captcha' => 'inherit',
            'input_fc_pagnumber' => 10,
            'input_fc_pagorientation' => 'center',
            'input_fc_reply_depth' => 3,
            'input_fc_dateformat' => 0
        ];
    }

    /**
     * Helper function to set the default value for a field
     * @param Field $field
     * @param $inputfield
     * @return mixed
     */
    protected function getConfigValue(Field $field, $inputfield): mixed
    {
        $name = $inputfield->name;
        return $field->$name ?? $this->getDefaultData()[$name];
    }
}

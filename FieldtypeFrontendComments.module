<?php

namespace ProcessWire;

/*
 * Comments Fieldtype for storing user comments for a page
 * This comment's field is especially designed to work with the FrontendForms module
 *
 * Created by Jürgen K.
 * https://github.com/juergenweb
 * File name: FieldtypeFrontendComments.module
 * Created: 23.04.2025
 */

use Exception;
use FrontendComments\FrontendComment;
use FrontendComments\FrontendCommentArray;
use FrontendComments\FrontendComments;
use FrontendComments\Notifications;
use PDO;

class FieldtypeFrontendComments extends FieldtypeMulti implements ConfigurableModule
{
    public const moderateNone = 0; // no moderation - all comments will be published immediately
    public const moderateAll = 1; // all comments need to be approved
    public const moderateNew = 2; // only new comments need to be approved
    public const pendingApproval = 0; // status waiting for approval
    public const approved = 1; // status approved
    public const spam = 2; // status SPAM
    public const featured = 4; // approved, but special marked as important
    public const queueTable = 'fc_comments_queues';

    // How long (in seconds) a "claimed" queue row is considered still in progress. LazyCron
    // is triggered by whichever visitor's request happens to be due for it, so two overlapping
    // requests could otherwise both pick up and send the same queued notification. A row whose
    // claim is older than this is treated as abandoned (e.g. the run that claimed it crashed or
    // timed out before finishing) and becomes eligible to be claimed and retried again.
    public const queueClaimStaleAfter = 300;

    /**
     * Directory where site developers may place their own theme template files to override the
     * ones shipped with the module, relative to $config->paths->assets (= /site/assets/ by default).
     * A file placed at <this path>/<theme>/<filename> (e.g. FrontendComments/templates/Bootstrap5/comment.php)
     * takes precedence over the module's own frameworks/Bootstrap5/templates/comment.php - see resolveTemplateFile().
     *
     * Note: this deliberately lives directly under site/assets/ and not under site/assets/files/,
     * because the latter is reserved by ProcessWire for page-attached files (Pagefiles, organized by
     * page ID). Change this constant if you prefer a different location, e.g. 'FrontendComments/' if
     * you want it resolved relative to $config->paths->templates instead - see resolveTemplateFile().
     */
    public const templateOverridePath = 'FrontendComments/templates/';

    protected FrontendForms $frontendForms;
    protected array $frontendFormsConfig = [];

    // Number of queued notification emails sent per LazyCron run (see sendQueuedEmails()).
    // This is a module-wide setting (the queue can hold entries from several different comment
    // fields at once), configurable via getModuleConfigInputfields() below; ProcessWire
    // automatically populates this property from the saved module configuration, falling back to
    // this default of 20 when nothing has been saved yet.
    protected string|int $input_fc_queue_batch = 20;

    /**
     * @throws WireException
     * @throws WirePermissionException
     */
    public function __construct()
    {

        parent::__construct();

        // grab the FrontendForms module to be able to use some methods of it
        $this->frontendForms = wire('modules')->get('FrontendForms');

        // grab configuration values from the FrontendForms module
        $this->frontendFormsConfig = self::getFrontendFormsConfigValues();

        // set database object
        $this->database = $this->wire()->database;
    }

    /**
     * Run during initialization
     * @return void
     */
    public function init(): void
    {
        parent::init();

        require_once(__DIR__ . '/FrontendComments.php');
        require_once(__DIR__ . '/frameworks/Uikit3/FrontendCommentsUikit3.php');
        require_once(__DIR__ . '/FrontendComment.php');
        require_once(__DIR__ . '/frameworks/Uikit3/FrontendCommentUikit3.php');
        require_once(__DIR__ . '/FrontendCommentPagination.php');
        require_once(__DIR__ . '/frameworks/Uikit3/FrontendCommentPaginationUikit3.php');
        require_once(__DIR__ . '/frameworks/Bootstrap5/FrontendCommentBootstrap5.php');
        require_once(__DIR__ . '/frameworks/Bootstrap5/FrontendCommentPaginationBootstrap5.php');
        require_once(__DIR__ . '/frameworks/Pico2/FrontendCommentPico2.php');
        require_once(__DIR__ . '/frameworks/Pico2/FrontendCommentPaginationPico2.php');
        require_once(__DIR__ . '/FrontendCommentArray.php');
        require_once(__DIR__ . '/frameworks/Bulma1/FrontendCommentBulma1.php');
        require_once(__DIR__ . '/frameworks/Bulma1/FrontendCommentPaginationBulma1.php');


        $this->addHookAfter('Inputfield::render', $this, 'overwriteExamplesNotes');
        $this->addHookAfter('LazyCron::every2Minutes', $this, 'sendQueuedEmails');
        $this->addHookAfter('ProcessField::fieldDeleted', $this, 'deleteVotesTable');
        $this->addHookBefore('Page::render', $this, 'noEmailWarning');
        $this->addHookAfter('LazyCron::everyDay', $this, 'deleteSpam');
        $this->addHookAfter('LazyCron::everyDay', $this, 'sendPendingReminders');
        $this->addHookBefore('InputfieldTextarea::processInput', $this, 'validateEmailAddresses');
        $this->addHookBefore('FieldtypeMulti::savePageField', $this, 'correctStatusValues');
        $this->addHookAfter('FieldtypeMulti::savePageField', $this, 'updateTables');
        $this->addHookBefore('Pages::save', $this, 'quietPageEditSaveForCommentsOnly');
    }

    /**
     * Array containing the texts for each status
     * @return array
     */
    public static function statusTexts(): array
    {
        return [
            0 => __('pending approval'),
            1 => __('approved'),
            2 => __('SPAM'),
            4 => __('featured')
        ];
    }

    /**
     * Check and change the status value before saving the comments again
     * This method runs before the savePageField method and validates the status value
     * @param HookEvent $event
     * @return void
     * @throws WireException
     */
    public function correctStatusValues(HookEvent $event): void
    {

        // run only on FieldtypeFrontendComments
        if ($event->object instanceof FieldtypeFrontendComments) {
            $page = $event->arguments(0);
            $field = $event->arguments(1);
            $fieldName = $field->name;
            $comments = $page->$fieldName;

            // run only if there is at least 1 status change of a comment inside the comments
            if ($comments->isChanged('statuschange')) {
                $n = 1;

                foreach ($comments as $comment) {
                    $text = null;

                    // run only if the status of this comment has been changed
                    if ($comment->isChanged('status')) {
                        // add remote flag 2 if status has been changed for the first time in backend and no remote flag is present
                        if ($this->wire('page')->rootParent->get('id') === 2) {
                            if (!$comment->remote_flag) {
                                $comment->remote_flag = 2;
                            }
                        }

                        $oldStatus = $comment->get('old_status');
                        $newStatus = $comment->get('status');

                        // Two of the three special status values need to be blocked under certain
                        // conditions, each for a different reason - so each uses its own guard,
                        // rather than a single "has any replies" gate (that gate used to wrap both
                        // cases below, but its check inside each case only ever counted approved
                        // replies, so a comment whose replies existed but were e.g. only pending or
                        // spam - or only featured, for the "delete" case - silently fell through
                        // both the blocking AND the statusChange/updateQueue bookkeeping further
                        // down: neither the revert nor the queue update ever happened):
                        if ($newStatus === FieldtypeFrontendComments::pendingApproval) {
                            // Reverting to "pending approval" removes this comment from the
                            // rendered tree entirely (see FrontendComments::getCommentsForDisplay()),
                            // which would make any already-visible (approved/featured) reply
                            // beneath it unreachable too. Only block when that would actually
                            // happen - a comment whose replies are themselves not yet visible has
                            // nothing to lose by reverting.
                            if ($comment->hasVisibleReplies()) {
                                $text = sprintf($this->_('The comment #%s cannot be set to the status "%s" because answers already exist. Therefore, the status remains at "%s".'), $n, self::statusTexts()[FieldtypeFrontendComments::pendingApproval], self::statusTexts()[$oldStatus]);
                            }
                        } elseif ($newStatus === 'delete') {
                            // Deleting physically removes the database row, so this must be
                            // blocked whenever ANY reply still references it via parent_id -
                            // regardless of that reply's own status - consistent with the
                            // stricter guard already used by FrontendCommentArray::deleteComment().
                            if ($comment->hasReplies()) {
                                $text = sprintf($this->_('Comment #%s cannot be deleted because there are already replies to this comment. Therefore, the status remains at "%s".'), $n, self::statusTexts()[$oldStatus]);
                                $text .= ' ' . $this->_('You must first delete all replies before you can delete this comment.');
                            }
                        }
                        // SPAM is deliberately not handled above - such a comment is kept in the
                        // rendered tree and shown as a placeholder instead of its real content
                        // (see FrontendComment::isSpamPlaceholder() / hasVisibleReplies()), so its
                        // status change never needs to be blocked and always falls through to the
                        // normal bookkeeping in the final "else" below, like any other accepted
                        // status change.

                        if (!is_null($text)) {
                            // blocked: revert the status change and warn
                            $comment->set('status', $oldStatus);
                            $this->warning($text);
                            $this->wire('session')->set('statuswarning-' . $comment->get('id'), $comment->get('id'));
                            $this->wire('session')->set('statuswarningtext-' . $comment->get('id'), $text);
                        } elseif ($newStatus === 'delete') {
                            // not blocked -> actually remove it
                            $comments->remove($comment);
                        } else {
                            // any other accepted status change (approved, featured, spam, or
                            // pending when there are no visible replies to orphan) -> normal
                            // queue/votes-table bookkeeping
                            $comment->set('statusChange', $newStatus);
                            $comment->set('updateQueue', 1);

                            // A comment being (re-)opened for moderation - reset the "already
                            // reminded" flag so sendPendingReminders() treats it as a fresh pending
                            // comment again and will notify moderators about it once more after the
                            // configured number of days, instead of silently never reminding about
                            // it again just because it happened to be pending once before (e.g. an
                            // approved comment that was reverted back to pending approval).
                            if ($newStatus === FieldtypeFrontendComments::pendingApproval) {
                                $comment->set('reminder_sent', 0);
                            }
                        }
                    }
                    $n++;
                }
            }

            //add the changed comment array to the page object
            $page->$fieldName = $comments;
            $event->arguments(0, $page);
        }
    }

    /**
     * "quiet_save" (input_fc_quiet_save, see getModuleConfigInputfields()) is meant to keep a
     * page's own "modified"/"modified_users_id" columns untouched whenever ONLY comment activity
     * happens - no matter whether that happens through the frontend comment form
     * (FrontendCommentForm::render() already honors it directly) or through the backend.
     *
     * On the backend there are two different paths, though, and only one of them ever goes
     * through this hook: FrontendCommentsManager saves a comment via
     * FrontendCommentArray::saveComment() -> Fieldtype::savePageField() directly, which never
     * calls Pages::save() at all and therefore never touches "modified" in the first place - so
     * quiet_save is a non-issue there. But a comments field can ALSO be edited directly on the
     * standard Page Edit screen (InputfieldFrontendComments::___render()/___processInput(), used
     * whenever the "Comments Manager" option is disabled) - and saving a page there always goes
     * through Pages::save(), which (per ProcessWire core) unconditionally bumps "modified"/
     * "modified_users_id" unless its own $options['quiet'] is true. Without this hook, editing,
     * approving or deleting a comment on that screen would always bump "modified", completely
     * ignoring quiet_save.
     *
     * This hook fixes exactly that gap - and only that gap: it forces $options['quiet'] = true
     * for a Pages::save() call if, and only if, EVERY FrontendComments field on the page that
     * actually had comment activity in this request has quiet_save enabled, AND no other field on
     * the page changed at all. If an admin edits the page's title (or any other field) in the same
     * save, "modified" is left alone as usual - quiet_save only ever suppresses the bump caused by
     * comment activity itself, never a genuine edit to something else.
     *
     * @param HookEvent $event
     * @return void
     */
    protected function quietPageEditSaveForCommentsOnly(HookEvent $event): void
    {
        $page = $event->arguments(0);
        $options = $event->arguments(1);
        if (!is_array($options)) {
            $options = [];
        }
        if (!empty($options['quiet'])) {
            return; // already quiet - nothing to do
        }

        // Whether comment activity happened at all on this page in this request is read from the
        // FrontendCommentArray's OWN change tracking (the same "isChanged('statuschange')"/etc.
        // bookkeeping InputfieldFrontendComments::___processInput() and correctStatusValues() above
        // already rely on) - not from $page->getChanges(), which may or may not list this
        // field (its items are mutated in place rather than the field being wholesale replaced).
        $commentChangeHappened = false;

        foreach ($this->wire('fields') as $field) {
            if (!($field->type instanceof self)) {
                continue;
            }

            $fieldName = $field->name;
            $comments = $page->$fieldName;
            if (!($comments instanceof FrontendCommentArray) || !$comments->isChanged()) {
                continue;
            }

            if (!$field->get('input_fc_quiet_save')) {
                return; // this field wants normal "modified" tracking -> leave the whole save alone
            }
            $commentChangeHappened = true;
        }

        if (!$commentChangeHappened) {
            return; // no comment activity in this save at all -> leave default behavior alone
        }

        // Comment activity happened, and every affected comments field wants quiet_save - now make
        // sure nothing ELSE on the page changed too (a title edit alongside a comment edit, say).
        // $page->getChanges() is authoritative for ordinary fields (title, etc.), whatever it does
        // or doesn't report for our own field above.
        foreach ($page->getChanges() as $changedFieldName) {
            $changedField = $this->wire('fields')->get($changedFieldName);
            if (!$changedField || !($changedField->type instanceof self)) {
                return; // some other, non-comments field also changed -> leave "modified" tracking alone
            }
        }

        $options['quiet'] = true;
        $event->arguments(1, $options);
    }

    /**
     * Add or delete entries in the fc_comments_queues table and the votes table
     * This method runs after the savePageField method and deletes or changes values inside the queue and votes tables
     * @param HookEvent $event
     * @return void
     */
    protected function updateTables(HookEvent $event): void
    {

        // run only on FieldtypeFrontendComments
        if ($event->object instanceof FieldtypeFrontendComments) {
            $page = $event->arguments(0);
            $field = $event->arguments(1);
            $comments = $page->get($field->name);

            // get all comments where the status have been updated
            foreach ($comments->find('updateQueue=1') as $comment) {
                $status = $comment->get('status');
                if ($status === self::approved || $status === self::featured) {
                    // add comment to the queue table
                    $comment->addCommentToQueueTable();
                } else {
                    // remove comment from the queue and votes table
                    $comment->deleteEntriesInQueueTable();
                    $comment->deleteEntriesInVotesTable();
                }
            }

            // add all new comments to the queue table if status is published
            foreach ($comments->getItemsAdded() as $comment) {
                // get the id property of the newly added comment from the database
                $id = $comment->getCommentIDFromDatabase();

                if (is_int($id)) {
                    $comment->set('id', $id);
                    if ($comment->isPublished()) {
                        $comment->addCommentToQueueTable();
                    }
                }
            }

            // remove all deleted comments from the queue table
            foreach ($comments->getItemsRemoved() as $comment) {
                $comment->deleteEntriesInQueueTable();
                $comment->deleteEntriesInVotesTable();
            }

            // get all comments where the status have been updated
            foreach ($comments->find('notificationStop=1') as $comment) {
                $comment->deleteEmailsInQueueTable();
            }
        }
    }

    /**
     * Group an assoc. array by a certain key
     * @param $array
     * @param $key
     * @return array
     */
    protected function groupBy($array, $key): array
    {
        $return = array();
        foreach ($array as $val) {
            $return[$val[$key]][] = $val;
        }
        return $return;
    }

    /**
     * Render all necessary CSS links
     * @param bool $useStarRating
     * @return string
     */
    public static function renderCSSFiles(bool $useStarRating = true): string
    {

        // url to FrontendComments asset folder
        $url = wire('config')->urls->get('FieldtypeFrontendComments') . 'assets/';

        // path to the assets folder
        $pathToCSSFile = wire('config')->paths->siteModules . 'FrontendComments/assets/';

        // get module version
        $moduleVersion = wire('modules')->getModuleInfo('FieldtypeFrontendComments')['version'];

        // get the framework
        $frameworkFile = FieldtypeFrontendComments::getFrontendFormsConfigValues()['input_framework'];
        $frameworkName = pathinfo($frameworkFile, PATHINFO_FILENAME);

        $out = '<link rel="stylesheet" type="text/css" href="' . $url . 'frontendcommentsmain.css?v=' . $moduleVersion . '">' . PHP_EOL;

        // check if CSS file exists for the given framework setting
        if (file_exists($pathToCSSFile . 'frontendcomments' . $frameworkName . '.css')) {
            // add CSS file
            $out .= '<link rel="stylesheet" type="text/css" href="' . $url . 'frontendcomments' . $frameworkName . '.css?v=' . $moduleVersion . '">' . PHP_EOL;
        }

        // add star-rating if enabled
        if ($useStarRating) {
            $out .= '<link rel="stylesheet" type="text/css" href="' . $url . 'star-rating.css?v=' . $moduleVersion . '">' . PHP_EOL;
        }

        return $out;
    }

    /**
     * Render all necessary JS links
     * @param bool $useStarRating
     * @return string
     */
    public static function renderJSFiles(bool $useStarRating = true): string
    {

        // url to FrontendComments asset folder
        $url = wire('config')->urls->get('FieldtypeFrontendComments') . 'assets/';

        // get module version
        $moduleVersion = wire('modules')->getModuleInfo('FieldtypeFrontendComments')['version'];

        $out = '<script src="' . $url . 'frontendcomments.js?v=' . $moduleVersion . '"></script>' . PHP_EOL;

        // pass the translated alert text to frontendcomments.js (shown if the Ajax reply form fails to load)
        $out .= '<script>window.loadingAlertText = ' . json_encode(__('Something went wrong!')) . ';</script>' . PHP_EOL;

        // add star rating JS to the frontend if enabled
        if ($useStarRating) {
            $out .= '<script src="' . $url . 'star-rating.min.js?v=' . $moduleVersion . ' "></script>' . PHP_EOL;
            $out .= "<script>let stars = new StarRating('.fcm-star-rating');</script>" . PHP_EOL;
        }
        return $out;
    }

    /**
     * Return all featured comments as a WireArray sitewide
     * @param int $limit
     * @return WireArray
     * @throws WireException
     */
    public static function getAllFeaturedComments(int $limit = 0): WireArray
    {

        $selects = [];
        $featured = self::featured;
        foreach (self::getAllCommentFields() as $field) {
            $selects[] = "SELECT * FROM $field->table WHERE status=$featured";
        }

        $statement = implode(' UNION ', $selects);
        $statement .= ' ORDER BY created DESC';
        if ($limit > 0) {
            $statement .= ' LIMIT ' . $limit;
        }

        $query = wire()->database->prepare($statement);
        $query->execute();

        $comments = [];
        while ($row = $query->fetch(PDO::FETCH_ASSOC)) {
            $comments[] = $row;
        }

        $featured_comments = new WireArray();
        foreach ($comments as $comment) {
            $featured_comments[] = $comment;
        }
        return $featured_comments;
    }

    /**
     * Get all queued emails from the database and send the emails in batches (see
     * input_fc_queue_batch / getModuleConfigInputfields()) at once
     * @return void
     * @throws WireException
     * @throws WirePermissionException
     * @throws WirePermissionException
     */
    protected function sendQueuedEmails(): void
    {

        // do not send notification mails if a stopqueue session is present
        if ($this->wire('session')->get('stopqueue')) {
            $this->wire('session')->remove('stopqueue');
            return;
        }

        // LazyCron is triggered by whichever visitor's request happens to be due for it, so two
        // overlapping requests could in principle both reach this method around the same time.
        // To prevent them from picking up and sending the same queued notification twice, rows
        // are "claimed" (a timestamp is written to their claimed column) before they are worked
        // on, and only rows this run actually managed to claim are processed further below.
        $now = time();
        $staleBefore = $now - self::queueClaimStaleAfter;

        // 1) find candidate rows: the oldest unclaimed ones, or ones whose claim is stale (a
        // previous run claimed them but never finished - e.g. it crashed or timed out - so they
        // are eligible to be retried)
        $select = "SELECT id FROM fc_comments_queues WHERE claimed = 0 OR claimed < :stale ORDER BY id LIMIT :limit";
        $query = $this->database->prepare($select);
        $query->bindValue(":stale", $staleBefore, PDO::PARAM_INT);
        $query->bindValue(":limit", $this->input_fc_queue_batch, PDO::PARAM_INT);
        $query->execute();

        $candidateIds = [];
        while ($row = $query->fetch(PDO::FETCH_ASSOC)) {
            $candidateIds[] = (int)$row['id'];
        }

        $mailinglist = [];

        if ($candidateIds) {
            // 2) actually claim only the candidates that are still eligible right now. If a
            // concurrent run claimed some of them in the meantime, this simply won't match those
            // rows - each row can only end up claimed by whichever run's UPDATE reaches it first.
            $idPlaceholders = implode(',', array_fill(0, count($candidateIds), '?'));
            $claimStatement = "UPDATE fc_comments_queues SET claimed=? WHERE id IN ($idPlaceholders) AND (claimed = 0 OR claimed < ?)";
            $claimQuery = $this->database->prepare($claimStatement);
            $claimQuery->execute([$now, ...$candidateIds, $staleBefore]);

            // 3) read back exactly the rows this run actually claimed (a row is only in this
            // result if it is both one of our candidates AND now carries our own claim timestamp)
            $select2 = "SELECT id, comment_id, email, field_id FROM fc_comments_queues WHERE id IN ($idPlaceholders) AND claimed = ? ORDER BY id";
            $query2 = $this->database->prepare($select2);
            $query2->execute([...$candidateIds, $now]);

            while ($row = $query2->fetch(PDO::FETCH_ASSOC)) {
                $mailinglist[] = $row;
            }
        }

        if ($mailinglist) {
            // group the entries by the field id
            $list = $this->groupBy($mailinglist, 'field_id');

            $statements = [];
            $bindings = [];
            $groupIndex = 0;

            foreach ($list as $field_id => $data) {
                $field = $this->wire('fields')->get($field_id);
                // get the table
                $commentTable = $this->database->escapeTable($field->table);

                // Restrict this SELECT to exactly the queue row ids fetched above for this field.
                // Without the "WHERE ... IN (...)" below, this join would pull in every pending
                // queue row for the field regardless of the batch size set above, which defeated
                // the whole point of batching (a busy field could end up sending its entire
                // backlog of queued emails in a single LazyCron run).
                $paramNames = [];
                foreach ($data as $i => $queueRow) {
                    $paramName = "qid{$groupIndex}_{$i}";
                    $paramNames[] = ":$paramName";
                    $bindings[$paramName] = (int)$queueRow['id'];
                }
                $placeholders = implode(',', $paramNames);

                $statements[] = "SELECT fc_comments_queues.id AS queue_id, fc_comments_queues.email, fc_comments_queues.field_id, $commentTable.id, $commentTable.pages_id, $commentTable.author, $commentTable.data, $commentTable.created, $commentTable.code FROM fc_comments_queues INNER JOIN $commentTable ON $commentTable.id=fc_comments_queues.comment_id AND fc_comments_queues.page_id=$commentTable.pages_id WHERE fc_comments_queues.id IN ($placeholders)";

                $groupIndex++;
            }

            $statement = implode(' UNION ', $statements);

            $query = $this->database->prepare($statement);
            foreach ($bindings as $paramName => $value) {
                $query->bindValue(":$paramName", $value, PDO::PARAM_INT);
            }
            $query->execute();

            $comments = [];
            while ($row = $query->fetch(PDO::FETCH_ASSOC)) {
                $comments[] = $row;
            }

            foreach ($comments as $row) {
                $queueId = $row['queue_id'];
                $page = $this->wire('pages')->get($row['pages_id']);
                $field = $this->wire('fields')->get($row['field_id']);

                // create a FrontendComment object out of the array
                $comment = $this->makeComment($page, $field, $row);

                // create a notification object
                require_once(__DIR__ . '/Notifications.php');
                $notifications = new Notifications($comments, $field, $page);
                if ($notifications->sendNotificationAboutNewReply($comment)) {
                    // Delete exactly this one queue row, identified by its own primary key -
                    // never affects any other recipient still waiting for their notification.
                    $statement = "DELETE FROM fc_comments_queues WHERE id=:id";

                    try {
                        $deleteQuery = $this->database->prepare($statement);
                        $deleteQuery->bindValue(":id", $queueId, PDO::PARAM_INT);
                        $deleteQuery->execute();
                    } catch (Exception) {
                        // not used at the moment
                    }
                }
            }
        }
    }

    /**
     * Delete the votes table of this comment field after the field has been deleted
     *
     * @param HookEvent $event
     * @return void
     */
    protected function deleteVotesTable(HookEvent $event): void
    {
        $field = $event->arguments(0);

        if ($field->type->className() !== 'FieldtypeFrontendComments') {
            return;
        }
        $tableName = $field->table . '_votes';
        $this->database->query("DROP TABLE IF EXISTS $tableName");
    }

    /**
     * Get all fields of the type "FieldtypeFrontendComments"
     * @return WireArray
     * @throws WireException
     */
    public static function getAllCommentFields(): WireArray
    {
        $items = new WireArray();
        $fields = wire('fields')->findByType('FieldtypeFrontendComments');
        if ($fields) {
            foreach ($fields as $field) {
                $items->add($field);
            }
        }
        return $items;
    }

    /**
     * Get all fields of the type "FieldtypeFrontendComments" that have no notification email added
     * @return array
     * @throws WireException
     */
    protected function getCommentFieldsWithoutNotificationEmail(): array
    {
        $fields = [];
        $configPage = false;

        $commentFields = self::getAllCommentFields();

        if ($commentFields->count()) {
            $ids = array_column($commentFields->getArray(), 'id');

            // check if we are on a field config page
            $currentUrl = $this->wire('input')->url(['withQueryString' => true]);

            $post = null;
            if ($_POST) {
                $post = $this->wire('input')->post();
                $currentUrl = $_SERVER['HTTP_REFERER'] ?? '';
            }

            if (str_contains($currentUrl, 'setup/field/edit')) {
                // check if query string id is inside the ids' array
                $editID = $this->wire('input')->get('id');
                if (in_array($editID, $ids)) {
                    $configPage = true;
                }
            }

            foreach ($commentFields as $field) {
                $notificationType = $field->input_fc_emailtype;
                if ($notificationType === 'text') {
                    if ($post) {
                        if ($configPage) {
                            $result = $post->get('input_fc_default_to');
                        } else {
                            $result = $this->wire('fields')->get($field->id)->get('input_fc_default_to');
                        }
                    } else {
                        $result = $field->get('input_fc_default_to');
                    }
                } else {
                    if ($post) {
                        if ($configPage) {
                            $result = $post->get('input_fc_emailfield');
                        } else {
                            $result = $this->wire('fields')->get($field->id)->get('input_fc_emailfield');
                        }
                    } else {
                        $result = $field->get('input_fc_emailfield');
                    }
                }
                if (!$result) {
                    $fields[] = $field;
                }
            }
        }
        return $fields;
    }

    /**
     * Check if a valid email address has been entered, or a PW email field has been selected inside the module
     * configuration of this module
     * addHookBefore Page::render
     * @return void
     * @throws WireException
     */
    protected function noEMailWarning(): void
    {
        // NOTE: this used to check only isLoggedin() - that shows this warning (including a direct
        // link to the field's backend configuration page under setup/field/edit) to EVERY logged-in
        // frontend user, e.g. any registered site member, not just admins/moderators. Editing a
        // field's configuration in ProcessWire (setup/field/edit) requires superuser access, so the
        // warning itself - and the link to fix it - is only relevant/actionable for a superuser.
        if ($this->wire('user')->isSuperuser()) {
            $fields = self::getCommentFieldsWithoutNotificationEmail();
            foreach ($fields as $field) {
                $url = $this->wire('config')->urls->admin . 'setup/field/edit?id=' . $field->id;
                $text = sprintf($this->_('The input field "%s" requires an email address to be able to send notification mails to at least one moderator.'), '<em>' . $field->name . '</em>') . '<br>';
                $text .= sprintf($this->_('Please go to the %s of this field and enter a valid email address or select a PW field that contains a valid email address inside %s tab.'), '<em>"' . $this->_('Details tab') . '</em>"', '<em>"' . $this->_('Default email configuration') . '</em>"') . '<br>';
                if ((int)$this->wire('input')->get('id') !== $field->id) {
                    $text .= '<a href="' . $url . '">' . $this->_('To the configuration page of this field') . '</a>';
                }
                $this->warning($text, Notice::allowMarkup);
            }
        }
    }

    /**
     * Delete all comments that are marked as spam after a given time period
     * @return void
     * @throws WireException
     */
    protected function deleteSpam(): void
    {
        // get all FrontendComments fields across the site

        $fields = $this->wire('fields')->findByType('FieldtypeFrontendComments');
        if (!$fields) {
            return;
        }

        // loop through all FrontendComments fields and delete all old spam entries
        foreach ($fields as $field) {
            $days = (int)$field->data['input_fc_spam'];
            if ($days > 0) {
                // NOTE: this used to delete ALL old spam rows unconditionally, including ones that
                // still have replies attached (via parent_id) - physically removing such a row
                // would orphan its replies (they'd still exist in the table but their parent row,
                // and with it the tombstone placeholder that keeps them reachable in the rendered
                // tree, would be gone). This is inconsistent with the stricter guard already used
                // everywhere else in this module (FrontendCommentArray::deleteComment() and the
                // "delete" status-change guard above both block deletion whenever ANY reply still
                // references the comment via parent_id, regardless of that reply's own status), so
                // apply the same guard here via a NOT EXISTS subquery.
                $statement = "DELETE FROM $field->table
                    WHERE status=2
                    AND created <= UNIX_TIMESTAMP(DATE_SUB(NOW(), INTERVAL $days DAY))
                    AND NOT EXISTS (
                        SELECT 1 FROM (SELECT parent_id FROM $field->table WHERE parent_id != 0) AS replies
                        WHERE replies.parent_id = $field->table.id
                    );";
                $query = $this->wire('database')->prepare($statement);

                try {
                    $query->execute();
                } catch (Exception) {
                    // not used at the moment
                }
            }
        }
    }

    /**
     * Remind the moderator(s) about comments that are still waiting for approval after the
     * configurable number of days set in "input_fc_pendingReminderDays" (0 = disabled, the
     * default - see getDefaultData() / ___getConfigInputfields()).
     *
     * Each comment is only ever reminded about once - the "reminder_sent" column (see
     * getDatabaseSchema()) tracks this. It is reset back to 0 whenever a comment's status is
     * (re-)set to "pending approval" again (see correctStatusValues()), so a comment that gets
     * reopened for moderation becomes eligible for a fresh reminder too, instead of being
     * silently skipped forever just because it was pending once before.
     * @return void
     * @throws WireException
     */
    protected function sendPendingReminders(): void
    {
        // get all FrontendComments fields across the site
        $fields = $this->wire('fields')->findByType('FieldtypeFrontendComments');
        if (!$fields) {
            return;
        }

        $pending = self::pendingApproval;
        $pages = $this->wire('pages');

        foreach ($fields as $field) {
            $days = (int)$field->data['input_fc_pendingReminderDays'];
            if ($days <= 0) {
                continue;
            }

            $statement = "SELECT * FROM $field->table
                WHERE status=$pending
                AND reminder_sent=0
                AND created <= UNIX_TIMESTAMP(DATE_SUB(NOW(), INTERVAL $days DAY))";
            $query = $this->wire('database')->prepare($statement);

            try {
                $query->execute();
            } catch (Exception) {
                // reminder_sent column not present yet on a site that hasn't run the 1.0.9
                // migration for this field's table (see ___upgrade()) - skip this field for now
                // rather than fataling the whole cron run for every other field too
                continue;
            }

            foreach ($query->fetchAll(PDO::FETCH_ASSOC) as $data) {
                $page = $pages->get((int)$data['pages_id']);

                // a page this comment belongs to may have been deleted without the comment row
                // itself being cleaned up - nothing sensible to notify about, so just mark it
                // handled so it stops being selected on every future run
                if ($page && $page->id) {
                    $comments = $this->getBlankValue($page, $field);
                    $moderationEmails = $comments->getModerationEmail();

                    if ($moderationEmails) {
                        // Note: $data is passed on as the raw database row, not turned into a full
                        // FrontendComment via makeComment() - the reminder mail only ever needs a
                        // handful of plain fields (author/email/text/created/code), so building the
                        // full, heavy comment object (avatar, links, vote widgets, ...) here would be
                        // pure overhead for a mail that never renders any of it.
                        $notifications = $this->wire(new Notifications($comments, $field, $page));
                        $notifications->sendPendingReminderMail($data, $moderationEmails, $days);
                    }
                }

                $update = $this->wire('database')->prepare("UPDATE $field->table SET reminder_sent=1 WHERE id=:id");
                $update->bindValue(':id', (int)$data['id'], PDO::PARAM_INT);
                $update->execute();
            }
        }
    }

    /**
     * Sanitize the textarea that there is only on item in one line and return the cleaned array
     * @param string|null $value
     * @return array
     */
    protected function sanitizeMultilineTextarea(string|null $value): array
    {
        if ($value == null) {
            return [];
        }

        // create an array of string with separator \n
        $items = explode("\n", $value);
        $value = [];
        foreach ($items as $item) {
            $value[] = trim(explode(" ", $item)[0]);
        }
        return $value;
    }

    /**
     * Validate all email addresses that have been entered for sending notification emails to
     * @param HookEvent $event
     * @return void
     */
    protected function validateEmailAddresses(HookEvent $event): void
    {
        if ($event->object->name === 'input_fc_default_to') {
            $value = $event->arguments(0);
            // sanitize all values first
            $dataArray = $this->sanitizeMultilineTextarea($value[$event->object->name]);
            //validate if all array items contain a valid IP address
            foreach ($dataArray as $key => $email) {
                if (!filter_var($email, FILTER_VALIDATE_EMAIL)) {
                    $this->wire->error(sprintf(
                        $this->_('%s is not a valid email address and has therefore been deleted.'),
                        $email
                    ));
                    unset($dataArray[$key]);
                }
            }
            // convert it back to string separated by \n
            $dataArray = implode("\n", array_unique($dataArray));
            $value->input_fc_default_to = $dataArray;
            $event->arguments(0, $value);
        }
    }

